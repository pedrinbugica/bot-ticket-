# Token do bot: https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=

# ID do servidor (Guild) — mesmo servidor onde o bot foi adicionado
GUILD_ID=

# ID da categoria onde os canais de ticket serão criados
TICKET_CATEGORY_ID=

# Cargos de suporte. Use SUPPORT_ROLE_IDS=id1,id2 ou um único SUPPORT_ROLE_ID=id
# (em SUPPORT_ROLE_ID também pode: id1,id2 na mesma linha — vírgula separa vários cargos).
# Não use o ID do servidor (GUILD_ID): esse é o cargo @everyone.
SUPPORT_ROLE_IDS=

# Canal de texto para logs ao fechar ticket (embed + transcript .txt). Opcional.
LOG_CHANNEL_ID=1503516916839354530

# Cor do painel/embeds em hex, ex: #5865F2 ou 5865F2
TICKET_PANEL_COLOR=#5865F2

# Regras exibidas no painel (use \n para quebras de linha). Opcional.
# TICKET_RULES=• Uma linha\n• Outra linha

# Se aparecer erro 50001 ao registrar comandos: reconvide com escopos bot + applications.commands
