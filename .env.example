# Obrigatório
DISCORD_TOKEN=

# Banco SQLite (criado automaticamente)
DATABASE_PATH=data/bot-ticket.db

# true = comandos globais (todos os servidores); false = registra por servidor ao entrar
DEPLOY_GLOBAL=false

# --- Legado (seed ao configurar o servidor com este GUILD_ID) ---
# GUILD_ID=
# TICKET_CATEGORY_ID=
# SUPPORT_ROLE_IDS=
# LOG_CHANNEL_ID=
# TICKET_PANEL_COLOR=#5865F2
# PANEL_TITLE=Central de atendimento
# PANEL_FOOTER=
# PANEL_DESCRIPTION=
# TICKET_RULES=• Um ticket por assunto.\n• Aguarde a equipe.

# Tipos padrão para novos servidores (JSON)
# TICKET_TYPES_PATH=config/ticket-types.json

# Fechar tickets sem mensagens após N horas (0 = desligado)
INACTIVITY_HOURS=0

# Enviar transcript por DM ao autor ao fechar
SEND_DM_ON_CLOSE=false

# Reconvide o bot com escopos bot + applications.commands se der erro 50001

# ── PAINEL WEB (opcional) ───────────────────────────────────────────────────
# Porta do servidor HTTP da API (padrão: 3000)
DASHBOARD_PORT=3000

# Client ID do bot no Discord Developer Portal (mesmo que já foi usado)
DISCORD_CLIENT_ID=

# Client Secret do OAuth2 — em Developer Portal → OAuth2 → Client Secret
DISCORD_CLIENT_SECRET=

# URL base da API (endereço público do bot no Discloud, ex: https://seubot.discloud.app)
DASHBOARD_URL=http://localhost:3000

# URL base do painel frontend (ex: https://seu-painel.vercel.app)
DASHBOARD_ORIGIN=http://localhost:5500

# String aleatória longa para assinar os tokens de sessão
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
