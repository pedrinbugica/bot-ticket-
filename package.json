{
  "name": "discord-admin-bot",
  "version": "2.0.0",
  "description": "Bot profissional de administração para Discord — tickets, moderação, logs, boas-vindas, menus de cargo, auto-mod, sorteios, enquetes, XP/níveis e tags",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node src/deploy-commands.js"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "keywords": [
    "discord",
    "bot",
    "tickets",
    "moderation",
    "leveling",
    "giveaway",
    "polls",
    "automod",
    "multi-guild"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "discord-api-types": "^0.38.40",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  }
}
